// Cole este código no Cloudflare Workers (dash.cloudflare.com → Workers & Pages → Create → cole aqui → Deploy).
// Função: recebe ?url=SEU_LINK, segue o redirecionamento (mesmo links curtos de afiliado)
// e devolve título, preço e foto do produto, sem travar por CORS no navegador.

export default {
  async fetch(request) {
    const corsHeaders = {
      "Access-Control-Allow-Origin": "*",
      "Access-Control-Allow-Methods": "GET, OPTIONS",
      "Access-Control-Allow-Headers": "Content-Type",
    };

    if (request.method === "OPTIONS") {
      return new Response(null, { headers: corsHeaders });
    }

    const { searchParams } = new URL(request.url);
    const target = searchParams.get("url");

    if (!target) {
      return json({ ok: false, error: "Faltou o parâmetro url" }, corsHeaders);
    }

    try {
      // Segue o link (curto ou completo) até a página final do produto
      const pageResp = await fetch(target, { redirect: "follow" });
      const finalUrl = pageResp.url;

      const match = finalUrl.match(/MLB-?(\d{6,})/i);
      if (!match) {
        return json(
          { ok: false, error: "Não achei o código do produto no link resolvido", finalUrl },
          corsHeaders
        );
      }
      const id = "MLB" + match[1];

      const itemResp = await fetch(
        `https://api.mercadolibre.com/items/${id}?attributes=id,title,price,original_price,thumbnail,pictures`
      );
      if (!itemResp.ok) {
        return json({ ok: false, error: "Mercado Livre não retornou dados desse item", id }, corsHeaders);
      }
      const data = await itemResp.json();
      const image =
        (data.pictures && data.pictures[0] && (data.pictures[0].secure_url || data.pictures[0].url)) ||
        data.thumbnail ||
        "";

      return json(
        {
          ok: true,
          id,
          title: data.title || "",
          price: data.price || null,
          original_price:
            data.original_price && data.original_price > data.price ? data.original_price : null,
          image,
        },
        corsHeaders
      );
    } catch (err) {
      return json({ ok: false, error: "Falha ao resolver o link: " + err.message }, corsHeaders);
    }
  },
};

function json(obj, extraHeaders) {
  return new Response(JSON.stringify(obj), {
    headers: { "Content-Type": "application/json", ...extraHeaders },
  });
}
